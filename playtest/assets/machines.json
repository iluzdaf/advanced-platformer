{
  "machines": {
    "bot": {
      "states": [
        { "name": "explore", "does": { "script": "bot", "activity": "explore" } },
        { "name": "travel", "does": { "script": "bot", "activity": "travel" } },
        { "name": "loot", "does": { "script": "bot", "activity": "loot" } },
        { "name": "kite", "does": { "script": "bot", "activity": "kite" } },
        { "name": "hold", "does": { "script": "bot", "activity": "hold" } },
        { "name": "dodge", "does": { "script": "bot", "activity": "dodge" } },
        { "name": "keepAway", "does": { "script": "bot", "activity": "keepAway" } },
        { "name": "heal", "does": { "script": "bot", "activity": "heal" } },
        { "name": "unstick", "does": { "script": "bot", "activity": "unstick" } },
        { "name": "switchWeapon", "does": { "script": "bot", "activity": "switchWeapon" } }
      ],
      "transitions": [
        {
          "from": [
            "explore",
            "travel",
            "loot",
            "kite",
            "hold",
            "dodge",
            "keepAway",
            "heal",
            "unstick"
          ],
          "to": "switchWeapon",
          "when": { "weaponBetter": true }
        },
        {
          "from": [
            "explore",
            "travel",
            "loot",
            "hold",
            "dodge",
            "keepAway",
            "heal",
            "unstick",
            "switchWeapon"
          ],
          "to": "kite",
          "when": { "targetClosingIn": true }
        },
        {
          "from": [
            "explore",
            "travel",
            "loot",
            "kite",
            "dodge",
            "keepAway",
            "heal",
            "unstick",
            "switchWeapon"
          ],
          "to": "hold",
          "when": { "targetClosingIn": false, "nonRatInRange": true }
        },
        {
          "from": [
            "explore",
            "travel",
            "loot",
            "kite",
            "hold",
            "keepAway",
            "heal",
            "unstick",
            "switchWeapon"
          ],
          "to": "dodge",
          "when": { "targetClosingIn": false, "nonRatInRange": false, "batDiving": true }
        },
        {
          "from": [
            "explore",
            "travel",
            "loot",
            "kite",
            "hold",
            "dodge",
            "heal",
            "unstick",
            "switchWeapon"
          ],
          "to": "keepAway",
          "when": {
            "targetClosingIn": false,
            "nonRatInRange": false,
            "batDiving": false,
            "spiderNear": true
          }
        },
        {
          "from": [
            "explore",
            "travel",
            "loot",
            "kite",
            "hold",
            "dodge",
            "keepAway",
            "heal",
            "switchWeapon"
          ],
          "to": "unstick",
          "when": {
            "targetClosingIn": false,
            "nonRatInRange": false,
            "batDiving": false,
            "spiderNear": false,
            "noProgress": true
          }
        },
        {
          "from": [
            "explore",
            "travel",
            "loot",
            "kite",
            "hold",
            "dodge",
            "keepAway",
            "unstick",
            "switchWeapon"
          ],
          "to": "heal",
          "when": {
            "targetClosingIn": false,
            "nonRatInRange": false,
            "batDiving": false,
            "spiderNear": false,
            "potionNeeded": true,
            "noProgress": false
          }
        },
        {
          "from": [
            "explore",
            "travel",
            "kite",
            "hold",
            "dodge",
            "keepAway",
            "heal",
            "unstick",
            "switchWeapon"
          ],
          "to": "loot",
          "when": {
            "targetClosingIn": false,
            "nonRatInRange": false,
            "batDiving": false,
            "spiderNear": false,
            "freedLootNearby": true,
            "potionNeeded": false,
            "noProgress": false
          }
        },
        {
          "from": [
            "travel",
            "loot",
            "kite",
            "hold",
            "dodge",
            "keepAway",
            "heal",
            "unstick",
            "switchWeapon"
          ],
          "to": "explore",
          "when": {
            "targetClosingIn": false,
            "nonRatInRange": false,
            "batDiving": false,
            "spiderNear": false,
            "freedLootNearby": false,
            "potionNeeded": false,
            "noProgress": false,
            "exitKnown": false
          }
        },
        {
          "from": [
            "explore",
            "loot",
            "kite",
            "hold",
            "dodge",
            "keepAway",
            "heal",
            "unstick",
            "switchWeapon"
          ],
          "to": "travel",
          "when": {
            "targetClosingIn": false,
            "nonRatInRange": false,
            "batDiving": false,
            "spiderNear": false,
            "freedLootNearby": false,
            "potionNeeded": false,
            "noProgress": false,
            "exitKnown": true
          }
        }
      ]
    }
  }
}
